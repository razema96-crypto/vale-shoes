# ---- VALE Shoes server configuration ----
# Copy to .env and fill in. Never commit .env.
PORT=8787
# Long random string used to sign admin sessions (required in production).
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=
# Optional: create the first admin on startup if no admin exists yet.
# (Alternatively run: npm run create-admin)
ADMIN_USERNAME=
ADMIN_PASSWORD=
# Public site URL (used for SEO / Open Graph tags), e.g. https://vale-shoes.com
PUBLIC_URL=http://localhost:8787
# Set to 0 to start with an empty catalog instead of the demo products.
SEED_DEMO_PRODUCTS=1
